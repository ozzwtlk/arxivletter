#!/usr/bin/env bash
# arXivletter launcher (adapted from AXIOM's): one command to run everything.
#
#   ./arxivletter            start (worker mode if set up, else everything on this PC), open the browser
#   ./arxivletter stop       stop what this launcher started
#   ./arxivletter status     show what is running
#   ./arxivletter logs       follow the logs
#   ./arxivletter install-desktop   add "arXivletter" to your application menu
#
# With a server (e.g. a Raspberry Pi running docker compose):
#   ./arxivletter new-token                     print a random shared secret for the server's .env
#   ./arxivletter setup-worker <server-url> [name]   make this PC/laptop a computing machine (asks for the token)
#   ./arxivletter worker                        connect to the server (+ start the local model if there is one)
#   ./arxivletter migrate-to-server <user@host:/path/to/server-data>   copy the local database to the server
#   ./arxivletter ship-server [-p port] <user@pi> [dir]   build the server image here (arm64), install it on the Pi
#
# The local model server is shared with AXIOM: if one is already running on the port it is reused.
#
# Services keep running in the background after this script exits; `./arxivletter stop` ends them.
# Already-running services (started by hand or by a previous launch) are reused, never restarted.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
APP_PORT="${ARXIVLETTER_APP_PORT:-8010}"
LLM_PORT="${ARXIVLETTER_LLM_PORT:-8081}"
APP_URL="http://127.0.0.1:${APP_PORT}"
RUN="$ROOT/data/run"
LOGS="$ROOT/data/logs"
WORKER_ENV="$ROOT/.arxivletter-worker.env"
mkdir -p "$RUN" "$LOGS"

say()  { printf '\033[1m%s\033[0m %s\n' "▸" "$*"; }
warn() { printf '\033[33m%s\033[0m %s\n' "!" "$*" >&2; }
die()  { printf '\033[31m%s\033[0m %s\n' "✗" "$*" >&2; exit 1; }

up() { curl -fsS -m 2 "$1" >/dev/null 2>&1; }
llm_up() { up "http://127.0.0.1:${LLM_PORT}/health"; }
app_up() { up "${APP_URL}/api/health"; }

wait_for() {  # wait_for <check-fn> <seconds> <what> <logfile>
  local fn=$1 secs=$2 what=$3 log=$4 i
  for ((i = 0; i < secs; i++)); do
    "$fn" && return 0
    sleep 1
    if (( i % 10 == 9 )); then printf '  …still waiting for %s (%ss)\n' "$what" "$((i + 1))"; fi
  done
  warn "$what did not come up within ${secs}s — last log lines:"
  tail -n 15 "$log" >&2 || true
  return 1
}

start_bg() {  # start_bg <name> <logfile> <cmd...>   (detached, survives this script)
  local name=$1 log=$2; shift 2
  nohup setsid "$@" >"$log" 2>&1 < /dev/null &
  echo $! > "$RUN/$name.pid"
}

frontend_stale() {
  local dist="$ROOT/frontend/dist/index.html"
  [[ ! -f "$dist" ]] && return 0
  [[ -n "$(find "$ROOT/frontend/src" "$ROOT/frontend/index.html" "$ROOT/frontend/package.json" -newer "$dist" -print -quit)" ]]
}

cmd_start() {
  local open_browser=1
  # all-in-one mode reads the same .env as the docker server (thresholds, contact e-mail, models, ...)
  if [[ -f "$ROOT/.env" ]]; then set -a; # shellcheck disable=SC1091
    source "$ROOT/.env"; set +a; fi
  [[ "${1:-}" == "--no-browser" ]] && open_browser=0
  command -v uv >/dev/null   || die "uv is not installed (https://docs.astral.sh/uv/)"
  command -v pnpm >/dev/null || die "pnpm is not installed (npm install -g pnpm)"

  # 1. frontend build (only when sources changed)
  if frontend_stale; then
    say "Building the reader UI…"
    (cd "$ROOT/frontend" && { [[ -d node_modules ]] || pnpm install --silent; } && pnpm -s build >"$LOGS/build.log" 2>&1) \
      || { tail -n 20 "$LOGS/build.log" >&2; die "frontend build failed (log: data/logs/build.log)"; }
  fi

  # 2. local model (optional: reading already-processed books works without it)
  if llm_up; then
    say "Local model already running on :${LLM_PORT}"
  elif [[ -x "$ROOT/scripts/start-local-llm.sh" ]]; then
    say "Starting the local model (first start loads ~20 GB, takes a minute)…"
    start_bg llm "$LOGS/llm.log" "$ROOT/scripts/start-local-llm.sh"
    wait_for llm_up 300 "the local model" "$LOGS/llm.log" \
      || warn "continuing without the local model: harvesting and reading work, digests wait for a model"
  fi

  # 3. the app (API + background workers + UI)
  if app_up; then
    say "arXivletter already running"
  else
    say "Starting arXivletter…"
    # shellcheck disable=SC2086  # ARXIVLETTER_SERVE_FLAGS is a word list, e.g. "--no-background"
    (cd "$ROOT/backend" && start_bg app "$LOGS/app.log" uv run arxivletter serve --port "$APP_PORT" ${ARXIVLETTER_SERVE_FLAGS:-})
    wait_for app_up 120 "arXivletter" "$LOGS/app.log" || die "arXivletter failed to start (log: data/logs/app.log)"
  fi

  say "Ready: ${APP_URL}   (stop with: ./arxivletter stop)"
  if (( open_browser )) && command -v xdg-open >/dev/null; then xdg-open "$APP_URL" >/dev/null 2>&1 || true; fi
}

stop_one() {  # only stops processes this launcher started (pid file), and their process group
  local name=$1 pidf="$RUN/$1.pid" pid
  [[ -f "$pidf" ]] || return 0
  pid=$(cat "$pidf")
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    say "stopped $name (pid $pid)"
  fi
  rm -f "$pidf"
}

cmd_stop() {
  stop_one worker
  stop_one app
  stop_one llm
  if app_up || llm_up; then
    warn "something is still running that this launcher did not start (started by hand? AXIOM's model server?):"
    app_up && warn "  arXivletter on :${APP_PORT}"
    llm_up && warn "  local model on :${LLM_PORT}"
  fi
  return 0
}

cmd_status() {
  if [[ -f "$WORKER_ENV" ]]; then
    load_worker_env
    if worker_up && worker_connected; then say "worker:      connected to ${ARXIVLETTER_SERVER_URL} as ${ARXIVLETTER_WORKER_NAME:-$(hostname)}"
    else say "worker:      not connected (server: ${ARXIVLETTER_SERVER_URL})"; fi
  fi
  if llm_up; then say "local model: running on :${LLM_PORT}"; else say "local model: stopped"; fi
  if app_up; then
    say "arXivletter: running at ${APP_URL}"
    curl -fsS -m 2 "${APP_URL}/api/health"; echo
  else
    say "arXivletter: stopped"
  fi
}


# ---------------------------------------------------------------- server / worker mode
load_worker_env() {
  [[ -f "$WORKER_ENV" ]] || die "not set up as a computing machine yet: ./arxivletter setup-worker <server-url> [name]"
  set -a; # shellcheck disable=SC1090
  source "$WORKER_ENV"; set +a
  [[ -n "${ARXIVLETTER_SERVER_URL:-}" && -n "${ARXIVLETTER_TOKEN:-}" ]] || die "$WORKER_ENV needs ARXIVLETTER_SERVER_URL and ARXIVLETTER_TOKEN"
}

cmd_new_token() { python3 -c "import secrets; print(secrets.token_hex(24))"; }

cmd_setup_worker() {
  local url=${1:-} name=${2:-$(hostname)} token
  [[ -n "$url" ]] || die "usage: ./arxivletter setup-worker <server-url, e.g. http://192.168.1.20:8080> [machine name]"
  url=${url%/}
  up "$url/api/health" || die "cannot reach $url (is the server running? is the address right?)"
  token=${ARXIVLETTER_TOKEN:-}
  [[ -n "$token" ]] || { read -r -s -p "ARXIVLETTER_TOKEN from the server's .env: " token; echo; }
  [[ ${#token} -ge 16 ]] || die "the token must be at least 16 characters"
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' -X POST "$url/internal/db/run" -H "Authorization: Bearer $token" \
         -H 'content-type: application/json' -d '{"sql":"SELECT 1","params":[]}')
  [[ "$code" == 200 ]] || die "the server rejected the token (HTTP $code)"
  umask 077
  printf 'ARXIVLETTER_SERVER_URL=%s\nARXIVLETTER_TOKEN=%s\nARXIVLETTER_WORKER_NAME=%s\n# ARXIVLETTER_WORKER_LOCAL_MODEL=off   # never start the local model on this machine\n# ARXIVLETTER_LOCAL_LLM_URL=http://127.0.0.1:8081/v1\n' \
    "$url" "$token" "$name" > "$WORKER_ENV"
  say "this machine is now “$name”, computing for $url  (config: .arxivletter-worker.env)"
  say "start it with: ./arxivletter worker"
}

worker_up() {  # our own worker process is alive (the server's online flag can lag behind a crash)
  local pidf="$RUN/worker.pid"
  [[ -f "$pidf" ]] && kill -0 "$(cat "$pidf")" 2>/dev/null
}

worker_connected() {
  curl -fsS -m 3 "${ARXIVLETTER_SERVER_URL}/api/workers" 2>/dev/null \
    | python3 -c "import json,sys; d=json.load(sys.stdin); sys.exit(0 if any(w['name']=='${ARXIVLETTER_WORKER_NAME:-$(hostname)}' and w['online'] for w in d['workers']) else 1)"
}

cmd_worker() {
  local open_browser=1
  [[ "${1:-}" == "--no-browser" ]] && open_browser=0
  load_worker_env
  command -v uv >/dev/null || die "uv is not installed (https://docs.astral.sh/uv/)"
  up "${ARXIVLETTER_SERVER_URL}/api/health" || die "cannot reach the server at ${ARXIVLETTER_SERVER_URL}"

  # local model only where it exists (your PC); a laptop uses its Claude Code / Codex logins
  if [[ "${ARXIVLETTER_WORKER_LOCAL_MODEL:-auto}" != off ]] && ! llm_up && [[ -x "$ROOT/scripts/start-local-llm.sh" ]] \
     && "$ROOT/scripts/start-local-llm.sh" --check >/dev/null 2>&1; then
    say "Starting the local model…"
    start_bg llm "$LOGS/llm.log" "$ROOT/scripts/start-local-llm.sh"
    wait_for llm_up 300 "the local model" "$LOGS/llm.log" || warn "continuing without the local model"
  fi

  if worker_up; then
    say "this machine is already connected to ${ARXIVLETTER_SERVER_URL}"
  else
    say "Connecting to ${ARXIVLETTER_SERVER_URL} as “${ARXIVLETTER_WORKER_NAME:-$(hostname)}”…"
    (cd "$ROOT/backend" && ARXIVLETTER_DATA_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/arxivletter-worker" \
       start_bg worker "$LOGS/worker.log" uv run arxivletter worker)
    wait_for worker_connected 90 "the connection to the server" "$LOGS/worker.log" || die "could not connect (log: data/logs/worker.log)"
  fi
  say "Ready: ${ARXIVLETTER_SERVER_URL}   (stop with: ./arxivletter stop)"
  if (( open_browser )) && command -v xdg-open >/dev/null; then xdg-open "${ARXIVLETTER_SERVER_URL}" >/dev/null 2>&1 || true; fi
}

cmd_migrate() {
  local target=${1:-}
  [[ -n "$target" ]] || die "usage: ./arxivletter migrate-to-server <user@host:/path/to/server-data>  (stop the server container first)"
  command -v rsync >/dev/null || die "rsync is not installed"
  [[ -f "$ROOT/data/arxivletter.db" ]] || die "no local data in $ROOT/data"
  local snap="$RUN/arxivletter-snapshot.db"
  say "Taking a consistent snapshot of the database…"
  python3 - "$ROOT/data/arxivletter.db" "$snap" <<'PY'
import sqlite3, sys
src, dst = sqlite3.connect(sys.argv[1]), sqlite3.connect(sys.argv[2])
src.backup(dst); dst.close()
PY
  say "Copying the database and stored sources to $target …"
  [[ -d "$ROOT/data/papers" ]] && rsync -a "$ROOT/data/papers" "$target/"
  rsync -a "$snap" "$target/arxivletter.db"
  rm -f "$snap"
  say "done. On the server: make sure the data dir is owned by uid 1000 (sudo chown -R 1000:1000 <dir>), then"
  say "      docker compose up -d   — and on this PC: ./arxivletter setup-worker http://<server>:<port>"
}

cmd_ship_server() {
  local port="" pos=() platform=${ARXIVLETTER_SERVER_PLATFORM:-linux/arm64}
  while (( $# )); do
    case "$1" in
      -p|--port) port=${2:-}; shift 2 || die "-p needs a port number" ;;
      -p*)       port=${1#-p}; shift ;;
      --port=*)  port=${1#--port=}; shift ;;
      *)         pos+=("$1"); shift ;;
    esac
  done
  local target=${pos[0]:-} dir=${pos[1]:-arxivletter}
  [[ -n "$target" ]] || die "usage: ./arxivletter ship-server [-p ssh-port] <user@pi-address> [directory on the Pi, default: ~/arxivletter]"
  [[ -z "$port" || "$port" =~ ^[0-9]+$ ]] || die "bad ssh port: $port"
  local SSH=(ssh) SCP=(scp -q)
  if [[ -n "$port" ]]; then SSH+=(-p "$port"); SCP+=(-P "$port"); fi
  docker buildx version >/dev/null 2>&1 \
    || die "docker buildx is missing — install it (Arch/CachyOS: sudo pacman -S docker-buildx)"
  if [[ "$platform" == linux/arm64 && "$(uname -m)" != aarch64 && ! -e /proc/sys/fs/binfmt_misc/qemu-aarch64 ]]; then
    die "this PC cannot build ARM images yet — install QEMU emulation:
     sudo pacman -S qemu-user-static qemu-user-static-binfmt && sudo systemctl restart systemd-binfmt
     (other distros: docker run --privileged --rm tonistiigi/binfmt --install arm64)"
  fi
  "${SSH[@]}" -o BatchMode=yes -o ConnectTimeout=8 "$target" 'docker version --format "{{.Server.Arch}}"' >/dev/null \
    || die "cannot run docker on $target over ssh (set up an ssh key, and add the user to the docker group on the Pi)"

  say "Building the server image for $platform (first build takes a while under emulation)…"
  local tar="$RUN/arxivletter-server-image.tar"
  docker buildx build --platform "$platform" -f "$ROOT/docker/Dockerfile" -t arxivletter-server:latest \
    --output "type=docker,dest=$tar" "$ROOT" || die "image build failed"
  say "Sending the image to $target ($(du -h "$tar" | cut -f1))…"
  gzip -c "$tar" | "${SSH[@]}" "$target" 'gunzip | docker load' || die "docker load on $target failed"
  rm -f "$tar"

  say "Installing the compose file in ~/$dir on $target…"
  "${SSH[@]}" "$target" "mkdir -p '$dir'"
  "${SCP[@]}" "$ROOT/deploy/pi/docker-compose.yml" "$target:$dir/docker-compose.yml"
  "${SCP[@]}" "$ROOT/.env.example" "$target:$dir/.env.example"
  if "${SSH[@]}" "$target" "grep -qE '^ARXIVLETTER_TOKEN=.{16,}' '$dir/.env' 2>/dev/null"; then
    "${SSH[@]}" "$target" "cd '$dir' && docker compose up -d" && say "server (re)started on $target"
  else
    say "next, on the Pi:  cd ~/$dir && cp .env.example .env && nano .env   (ARXIVLETTER_TOKEN: ./arxivletter new-token)"
    say "                  sudo install -d -m 0750 -o 1000 -g 1000 ./server-data  # or your ARXIVLETTER_DATA path"
    say "                  docker compose up -d"
  fi
}

cmd_install_desktop() {
  local f="$HOME/.local/share/applications/arxivletter.desktop"
  mkdir -p "$(dirname "$f")"
  cat >"$f" <<EOF
[Desktop Entry]
Type=Application
Name=arXivletter
Comment=hep-ph / hep-th research digest
Exec=$ROOT/arxivletter
Terminal=false
Categories=Education;Science;
EOF
  say "added $f — arXivletter is now in your application menu"
}

default_start() { if [[ -f "$WORKER_ENV" ]]; then cmd_worker "$@"; else cmd_start "$@"; fi; }

case "${1:-start}" in
  start)           shift || true; default_start "$@" ;;
  --no-browser)    default_start --no-browser ;;
  local)           shift; cmd_start "$@" ;;
  worker)          shift; cmd_worker "$@" ;;
  setup-worker)    shift; cmd_setup_worker "$@" ;;
  new-token)       cmd_new_token ;;
  migrate-to-server) shift; cmd_migrate "$@" ;;
  ship-server)     shift; cmd_ship_server "$@" ;;
  stop)            cmd_stop ;;
  restart)         cmd_stop; sleep 2; default_start ;;
  status)          cmd_status ;;
  logs)            tail -n 30 -F "$LOGS"/*.log ;;
  install-desktop) cmd_install_desktop ;;
  -h|--help|help)  sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)               die "unknown command '$1' (try ./arxivletter help)" ;;
esac
