# ---------------------------------------------------------------------------------------------------------------
# arXivletter configuration. Server (docker compose): copy to .env. Every variable has a sensible default.
# ---------------------------------------------------------------------------------------------------------------

# Shared secret between the server and the computing machines (≥ 16 characters): ./arxivletter new-token
ARXIVLETTER_TOKEN=
# Identify yourself to arXiv (sent in the User-Agent, as arXiv asks of API clients)
ARXIVLETTER_CONTACT_EMAIL=
# Port on the server and where its data lives (database, stored source text). An SSD beats an SD card.
ARXIVLETTER_PORT=8282
ARXIVLETTER_DATA=./server-data

# ---- what to ingest and when
ARXIVLETTER_CATEGORIES=hep-ph,hep-th
ARXIVLETTER_HARVEST_EVERY_MIN=60          # OAI-PMH harvest interval
ARXIVLETTER_HARVEST_LOOKBACK_DAYS=3       # overlapping windows are cheap and catch late OAI updates
ARXIVLETTER_FETCH_ON_SERVER=1             # download + parse sources on the server (no model needed)
ARXIVLETTER_KEEP_SOURCE_TEXT=1            # keep tex/bbl/bib (~50 kB/paper) so parser upgrades need no re-download
ARXIVLETTER_REQUEST_INTERVAL=3.1          # seconds between arXiv requests (arXiv asks for ≥ 3)

# ---- processing policy / cost control (relevance is 0–10)
ARXIVLETTER_DIGEST_MIN_RELEVANCE=5        # automatic digests at 5/10 or higher; manual requests bypass this
ARXIVLETTER_FULL_DIGEST_MIN_RELEVANCE=4.5 # full map-reduce digest of the whole text above this
ARXIVLETTER_PREMIUM_MIN_RELEVANCE=6.5     # premium research-gap analysis above this (and for starred papers)
ARXIVLETTER_PREMIUM_DAILY_PAPERS=12       # at most this many automatic premium analyses per day
ARXIVLETTER_REVISION_MIN_RELEVANCE=5      # re-digest revised versions above this (or when the change is major)
ARXIVLETTER_BRIEF=1                       # daily cross-paper synthesis
ARXIVLETTER_BRIEF_TOP_N=12

# ---- models (used on the computing machines; the server never runs a model)
ARXIVLETTER_LOCAL_LLM_URL=http://127.0.0.1:8081/v1   # llama.cpp / vLLM / Ollama (OpenAI-compatible)
ARXIVLETTER_LOCAL_MODEL=qwen3.6-35b-a3b-q4kxl
ARXIVLETTER_LOCAL_CTX=16384               # tokens per llama.cpp slot (-c / -np); chunk sizes follow from this
ARXIVLETTER_LOCAL_CONCURRENCY=2
ARXIVLETTER_LOCAL_LLAMACPP=1              # 0 for non-llama.cpp servers (uses response_format json_schema)
ARXIVLETTER_LLM_WORKERS=2                 # parallel triage/digest job threads per machine
ARXIVLETTER_PREMIUM_WORKERS=1             # parallel gap/brief job threads per machine
ARXIVLETTER_PREMIUM_CONCURRENCY=2          # max in-flight calls per premium model on this machine
ARXIVLETTER_CODEX_DIGEST_DAILY_CEILING=0   # idle premium slots can take digests until this many Codex calls/day; 0 disables
ARXIVLETTER_PREMIUM_ORDER=claude-code:opus,claude-code:sonnet,codex:default,api:anthropic,api:openai
ARXIVLETTER_SUBSCRIPTION_DAILY_LIMIT=60   # calls per subscription CLI / paid API per day
ARXIVLETTER_CLOUD=1                       # let "auto" use premium models for gaps and briefs
# ANTHROPIC_API_KEY=                      # optional paid APIs (per-token billing)
# OPENAI_API_KEY=

# ---- observability
ARXIVLETTER_LOG_LEVEL=INFO
ARXIVLETTER_LOG_FORMAT=text               # json for log shippers
